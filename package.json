{
  "name": "chess-algorithm-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A browser-based laboratory for learning algorithms through chessboard problems.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
